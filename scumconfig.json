    {
        "DisplayName": "Enable ForceBindIP (Windows)",
        "Category": "SCUM:stadia_controller",
        "Subcategory": "Network Binding:lan:2",
        "Description": "Launches SCUMServer.exe through ForceBindIP64.exe so SCUM can bind to a specific local IPv4 address or interface GUID. Requires ForceBindIP 1.3+ installed on the Windows host. ForceBindIP injects a DLL into the server process, so use with care when BattlEye is enabled.",
        "Keywords": "forcebindip,bind,ip,interface,guid,multihome,windows",
        "FieldName": "forcebindip",
        "InputType": "checkbox",
        "ParamFieldName": "forcebindip",
        "DefaultValue": "",
        "EnumValues": {
            "False": "",
            "True": "-AMPForceBindIPEnabled "
        }
    },
